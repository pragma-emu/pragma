{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build Switch 2 Emulator",
            "command": "C:/w64devkit/bin/g++.exe",
            "args": [
                "-std=c++20",
                "src/main.cpp",
                "src/switch_cpu.cpp",
                "-I", "src/",
                "-I", "externals/dynarmic/src/",
                "-o", "switch2_emu.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
